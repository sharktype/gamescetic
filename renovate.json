{
	"extends": ["config:recommended"],
	"timezone": "UTC",
	"schedule": ["after 9am on thursday"],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"automergeType": "branch"
	},
	"hostRules": [],
	"packageRules": [
		{
			"groupName": "chore: dev dependencies safe update",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["patch", "minor"],
			"matchCurrentVersion": "!/^v?0\\./",
			"automerge": true,
			"automergeType": "branch"
		},
		{
			"groupName": "task: dependencies safe update",
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["patch", "minor"],
			"matchCurrentVersion": "!/^v?0\\./",
			"automerge": true,
			"automergeType": "branch"
		},
		{
			"groupName": "task: peer dependencies safe update",
			"matchDepTypes": ["peerDependencies"],
			"matchUpdateTypes": ["patch", "minor"],
			"matchCurrentVersion": "!/^v?0\\./",
			"automerge": true,
			"automergeType": "branch"
		},
		{
			"groupName": "task: go dependencies safe update",
			"matchManagers": ["gomod"],
			"matchUpdateTypes": ["patch", "minor"],
			"matchCurrentVersion": "!/^v?0\\./",
			"automerge": true,
			"automergeType": "branch"
		},
		{
			"groupName": "task: github actions update",
			"matchManagers": ["github-actions"],
			"separateMajorMinor": false,
			"automerge": false
		}
	]
}
